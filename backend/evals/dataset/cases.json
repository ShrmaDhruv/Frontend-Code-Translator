{
  "version": 1,
  "targets": ["React", "Vue", "Angular", "HTML"],
  "concepts": {
    "counter": {
      "difficulty": "easy",
      "behaviors": [
        "The displayed count starts at the initial value (0 by default).",
        "The '+' button increases the count by the step size (1 by default).",
        "The '-' button decreases the count by the step size.",
        "The 'Reset' button returns the count to the initial value.",
        "A label shows 'Even' when the count is even and 'Odd' when it is odd, and it updates whenever the count changes."
      ]
    },
    "todo_list": {
      "difficulty": "medium",
      "behaviors": [
        "A heading shows the list title ('My Todos' by default).",
        "Typing text and clicking 'Add' appends a new, not-done todo and clears the input.",
        "Clicking 'Add' with empty or whitespace-only input does nothing.",
        "Each todo has a checkbox that toggles its done state, and done todos are visually marked (for example a 'done' class with strike-through).",
        "Each todo has a 'Delete' button that removes only that todo.",
        "When there are no todos, the text 'No todos yet' is shown instead of the list.",
        "A footer shows how many todos are not done, followed by the word 'remaining'."
      ]
    },
    "session_timer": {
      "difficulty": "hard",
      "behaviors": [
        "A heading shows the label ('Session' by default).",
        "Elapsed time since the component mounted (or the page loaded) is displayed as zero-padded MM:SS, starting at 00:00.",
        "Elapsed time increases by one second every second, driven by an interval started on mount/load.",
        "The 'Reset' button sets elapsed time back to 00:00 without stopping the timer.",
        "Once elapsed seconds reach the limit (60 by default), the message \"Time's up!\" is shown.",
        "If the target framework has a teardown lifecycle (React effect cleanup, Vue onUnmounted, Angular ngOnDestroy), the interval is cleared there so no timer leaks."
      ]
    }
  },
  "judge_notes": "Values that are hardcoded constants in a plain-HTML source (initial value, step, limit, title, label) may become props or stay constants in the target; either is acceptable as long as the default behavior matches.",
  "cases": [
    {
      "id": "react-counter",
      "source": "React",
      "concept": "counter",
      "file": "components/react/counter.jsx",
      "expected_ir": {
        "component": "Counter",
        "props": ["initial", "step"],
        "state": ["count"],
        "computed": ["isEven"],
        "methods": ["increment", "decrement", "reset"],
        "lifecycle": []
      }
    },
    {
      "id": "react-todo_list",
      "source": "React",
      "concept": "todo_list",
      "file": "components/react/todo_list.jsx",
      "expected_ir": {
        "component": "TodoList",
        "props": ["title"],
        "state": ["todos", "newTodo"],
        "computed": ["remaining"],
        "methods": ["addTodo", "toggleTodo", "removeTodo"],
        "lifecycle": []
      }
    },
    {
      "id": "react-session_timer",
      "source": "React",
      "concept": "session_timer",
      "file": "components/react/session_timer.jsx",
      "expected_ir": {
        "component": "SessionTimer",
        "props": ["label", "limit"],
        "state": ["seconds"],
        "computed": ["formatted", "expired"],
        "methods": ["reset"],
        "lifecycle": ["onMount", "onDestroy"]
      }
    },
