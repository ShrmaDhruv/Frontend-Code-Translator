{
  "description": "Hand-labelled translations for measuring the LLM judge. `expected` has one bool per behavior of the concept in dataset/cases.json (true = the translation implements it). Several cases are deliberately broken; several are correct but use negated or unusual logic the judge has misread before.",
  "cases": [
    {
      "id": "timer-html-vue-correct-hidden",
      "concept": "session_timer", "source": "HTML", "source_file": "components/html/session_timer.html",
      "target": "Vue", "translation": "timer_html_vue_correct_hidden.vue",
      "expected": [true, true, true, true, true, true],
      "note": "correct; :hidden=\"seconds < LIMIT\" (negated), limit stays a constant (allowed by judge notes)"
    },
    {
      "id": "timer-html-react-correct-hidden",
      "concept": "session_timer", "source": "HTML", "source_file": "components/html/session_timer.html",
      "target": "React", "translation": "timer_html_react_correct_hidden.jsx",
      "expected": [true, true, true, true, true, true],
      "note": "correct; hidden={seconds < limit}"
    },
    {
      "id": "timer-react-vue-reset-stops",
      "concept": "session_timer", "source": "React", "source_file": "components/react/session_timer.jsx",
      "target": "Vue", "translation": "timer_react_vue_reset_stops.vue",
      "expected": [true, true, true, false, true, true],
      "note": "BUG: reset clears the interval, so the timer stops"
    },
    {
      "id": "timer-react-angular-off-by-one",
      "concept": "session_timer", "source": "React", "source_file": "components/react/session_timer.jsx",
      "target": "Angular", "translation": "timer_react_angular_off_by_one.ts",
      "expected": [true, true, true, true, false, true],
      "note": "BUG: expired uses > instead of >=, message appears one second late"
    },
    {
      "id": "timer-vue-react-no-cleanup",
      "concept": "session_timer", "source": "Vue", "source_file": "components/vue/session_timer.vue",
      "target": "React", "translation": "timer_vue_react_no_cleanup.jsx",
      "expected": [true, true, true, true, true, false],
      "note": "BUG: useEffect never returns a cleanup, interval leaks"
    },
    {
      "id": "timer-angular-vue-correct-vshow",
      "concept": "session_timer", "source": "Angular", "source_file": "components/angular/session_timer.component.ts",
      "target": "Vue", "translation": "timer_angular_vue_correct_vshow.vue",
      "expected": [true, true, true, true, true, true],
      "note": "correct; v-show=\"!notExpired\" double negation (not in judge prompt)"
    },
    {
      "id": "counter-react-vue-ignores-step",
      "concept": "counter", "source": "React", "source_file": "components/react/counter.jsx",
      "target": "Vue", "translation": "counter_react_vue_ignores_step.vue",
      "expected": [true, false, true, true, true],
      "note": "BUG: + uses count++ and ignores the step prop (only correct when step is 1)"
    },
    {
      "id": "counter-vue-react-correct-odd-first",
      "concept": "counter", "source": "Vue", "source_file": "components/vue/counter.vue",
      "target": "React", "translation": "counter_vue_react_correct_odd_first.jsx",
      "expected": [true, true, true, true, true],
      "note": "correct; parity written as count % 2 ? 'Odd' : 'Even'"
    },
    {
      "id": "counter-react-angular-reset-zero",
      "concept": "counter", "source": "React", "source_file": "components/react/counter.jsx",
      "target": "Angular", "translation": "counter_react_angular_reset_zero.ts",
      "expected": [true, true, true, false, true],
      "note": "BUG: reset sets 0 instead of the initial prop"
    },
    {
      "id": "todo-react-vue-no-trim",
      "concept": "todo_list", "source": "React", "source_file": "components/react/todo_list.jsx",
      "target": "Vue", "translation": "todo_react_vue_no_trim.vue",
      "expected": [true, true, false, true, true, true, true],
      "note": "BUG: whitespace-only input is added as a todo"
    },
    {
      "id": "todo-vue-react-correct",
      "concept": "todo_list", "source": "Vue", "source_file": "components/vue/todo_list.vue",
      "target": "React", "translation": "todo_vue_react_correct.jsx",
      "expected": [true, true, true, true, true, true, true],
      "note": "correct; empty state via !todos.length"
    },
    {
      "id": "todo-html-angular-delete-wrong",
      "concept": "todo_list", "source": "HTML", "source_file": "components/html/todo_list.html",
      "target": "Angular", "translation": "todo_html_angular_delete_wrong.ts",
      "expected": [true, true, true, true, false, true, true],
      "note": "BUG: removeTodo keeps only the clicked todo (=== instead of !==)"
    }
  ]
}
